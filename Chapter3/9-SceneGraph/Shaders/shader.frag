#version 330 core
in vec3 worldPosition;in vec3 worldNormal;out vec4 fragmentColor;uniform vec3 uCameraPosition;uniform vec3 uSunDirection;uniform vec3 uFillPosition;uniform vec3 uRimPosition;vec3 point(vec3 p,vec3 c,float s,vec3 n,vec3 v){vec3 l=normalize(p-worldPosition);float d=length(p-worldPosition);float diff=max(dot(n,l),0.);float spec=pow(max(dot(n,normalize(l+v)),0.),32.);return(vec3(diff)+vec3(spec))*c*s/(1.+d*d*.15);}void main(){vec3 n=normalize(worldNormal);vec3 v=normalize(uCameraPosition-worldPosition);vec3 sun=vec3(.12)+vec3(1.,.95,.8)*max(dot(n,normalize(-uSunDirection)),0.);fragmentColor=vec4(sun+point(uFillPosition,vec3(.3,.45,1),.8,n,v)+point(uRimPosition,vec3(1,.25,.15),.7,n,v),1);}
